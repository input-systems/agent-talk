{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 140,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf",
    "sortPackageJson": false,
    "ignorePatterns": ["dist", "site/dist", "spec/vectors/*.json"]
}
