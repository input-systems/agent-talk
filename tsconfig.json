{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "lib": ["esnext", "dom"],
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src/**/*", "spec/**/*", "scripts/**/*", "site/**/*", "vitest.config.ts", "oxlint.config.ts"]
}
