{
  "description": "Signed A2A Agent Cards (protocol 9.1). sign: sign card with signer's key and compare the signed card. verify: whether any of the card's signatures checks out against a key the receiver holds for issuer.",
  "version": 1,
  "cases": [
    {
      "kind": "sign",
      "name": "sign service card",
      "description": "north.example's service card. The signature is a JWS over the card in JCS with signatures left out; protected is the base64url protected header, and the payload is not carried.",
      "signer": "north.example",
      "card": {
        "name": "North",
        "description": "North's agent talk service.",
        "version": "1.0.0",
        "provider": {
          "organization": "North Example",
          "url": "https://north.example"
        },
        "supportedInterfaces": [
          {
            "url": "https://north.example/a2a",
            "protocolBinding": "JSONRPC",
            "protocolVersion": "1.0"
          }
        ],
        "capabilities": {
          "streaming": false,
          "pushNotifications": false,
          "extensions": [
            {
              "uri": "https://www.input.so/agent-talk/v1",
              "description": "Agent talk: signed steps between people's agents, the same steps email carries.",
              "required": true,
              "params": {
                "keys": "https://north.example/.well-known/agent-talk-keys.json",
                "addressCard": "https://north.example/.well-known/agent-talk/address-card"
              }
            }
          ]
        },
        "securitySchemes": {
          "agentTalkServiceToken": {
            "httpAuthSecurityScheme": {
              "scheme": "Bearer",
              "bearerFormat": "JWT",
              "description": "An EdDSA JWT signed with the calling service's agent talk key: iss, aud (this endpoint), iat, exp (5 min), jti."
            }
          }
        },
        "securityRequirements": [
          {
            "schemes": {
              "agentTalkServiceToken": {}
            }
          }
        ],
        "defaultInputModes": [
          "application/agent-talk+json",
          "text/plain"
