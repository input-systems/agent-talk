{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://input.so/agent-talk/v1/schemas/value.schema.json",
    "title": "Agent Talk value",
    "description": "A value a step asks for, hands over or records. Every value carries its own text, so a receiver shows the text of a type it does not know: a private one (x-…) or one a later version added.",
    "$comment": "Not expressible here: a time's end after its start, and a busy value's blocks inside from and to (the code checks end > start for time only). Unknown properties are allowed: receivers ignore fields they do not know.",
    "type": "object",
    "required": ["type", "text"],
    "properties": {
        "type": { "$ref": "common.schema.json#/$defs/typeName" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "allOf": [
        {
            "if": { "properties": { "type": { "const": "time" } }, "required": ["type"] },
            "then": {
                "required": ["start", "end", "timeZone"],
                "properties": {
                    "start": { "$ref": "common.schema.json#/$defs/time" },
                    "end": { "$ref": "common.schema.json#/$defs/time" },
                    "timeZone": { "description": "An IANA zone name.", "type": "string", "minLength": 1, "maxLength": 64 },
                    "place": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "isCall": { "type": "boolean" }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "busy" } }, "required": ["type"] },
            "then": {
                "required": ["from", "to", "blocks"],
                "properties": {
                    "from": { "$ref": "common.schema.json#/$defs/time" },
                    "to": { "$ref": "common.schema.json#/$defs/time" },
                    "blocks": {
                        "type": "array",
                        "maxItems": 500,
                        "items": {
                            "type": "object",
                            "required": ["start", "end"],
                            "properties": {
                                "start": { "$ref": "common.schema.json#/$defs/time" },
                                "end": { "$ref": "common.schema.json#/$defs/time" }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "date" } }, "required": ["type"] },
            "then": {
                "$comment": "Only the shape is checked, as in the code: 2026-99-99 passes both.",
                "required": ["date"],
                "properties": {
                    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date" }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "place" } }, "required": ["type"] },
            "then": {
                "required": ["name"],
                "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "address": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "contact" } }, "required": ["type"] },
            "then": {
                "required": ["address"],
                "properties": {
                    "address": { "$ref": "common.schema.json#/$defs/address" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "amount" } }, "required": ["type"] },
            "then": {
                "required": ["currency", "amount"],
                "properties": {
                    "currency": { "description": "An ISO 4217 code.", "type": "string", "pattern": "^[A-Z]{3}$" },
                    "amount": { "description": "A decimal string.", "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "link" } }, "required": ["type"] },
            "then": {
                "required": ["url"],
                "properties": {
                    "url": { "type": "string", "pattern": "^https://" }
                }
            }
        },
        {
            "if": { "properties": { "type": { "const": "file" } }, "required": ["type"] },
            "then": {
                "required": ["name", "mediaType", "size", "sha256", "url"],
                "properties": {
                    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "mediaType": { "type": "string", "minLength": 1, "maxLength": 255 },
                    "size": { "description": "A byte count.", "type": "integer", "minimum": 0 },
                    "sha256": { "description": "A lowercase hex SHA-256.", "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "url": { "type": "string", "pattern": "^https://" }
                }
            }
        }
    ]
}
