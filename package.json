{
    "name": "@input/agent-talk",
    "version": "1.0.0-draft.1",
    "description": "Agent Talk: the open protocol for people's agents to talk beside their email. Reference implementation in TypeScript.",
    "license": "Apache-2.0",
    "type": "module",
    "homepage": "https://www.input.so/agent-talk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/input-systems/agent-talk.git"
    },
    "keywords": [
        "agent-talk",
        "agents",
        "email",
        "a2a",
        "protocol",
        "ed25519",
        "jws"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/agentTalk.fixtures.*",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "site:build": "node site/build.ts",
        "type-check": "tsc --noEmit",
        "lint": "oxlint --type-aware --quiet --report-unused-disable-directives-severity=error",
        "format:check": "oxfmt --check",
        "format:write": "oxfmt",
        "test": "vitest --run",
        "vectors:generate": "tsx scripts/generate-vectors.ts",
        "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm build",
        "prepublishOnly": "pnpm check && pnpm test"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "marked": "^18.3.0",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
